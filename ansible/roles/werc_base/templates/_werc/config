plan9port=$PLAN9
path=($plan9port/bin . ./bin ./bin/contrib /bin /usr/bin)
formatter=(fltr_cache md2html.awk)	# no perl for old men
debug=true # Enable debugging, to disable set to ()
enabled_apps=()

{% set site_project = werc_projects | selectattr("name", "equalto", werc_site) | first | default({}) %}
{% if werc_site != 'luvi.net' %}masterSite='luvi.net'{% endif %}

{% if site_project.get('werc_page_title') %}
pageTitle='{{ site_project.get('werc_page_title') | replace("'", "''") }}'
{% endif %}
siteTitle='{{ site_project.get('werc_site_title') | default(werc_site, true) | replace("'", "''") }}'
siteSubTitle='{{ site_project.get('werc_site_sub_title') | default('', true) | replace("'", "''") }}'

site_url='{{ site_project.get('url') | default('', true) }}'
meta_keywords='{{ werc_meta_keywords | replace("'", "''") }}'
enabled_sites=({% for site in enabled_werc_sites %}{% if site != 'luvi.net' %}{{ site | split('.') | first }} {% endif %}{% endfor %})
{% if site_project.get('werc_meta_desc') %}
meta_description='{{ site_project.get('werc_meta_desc') | replace("'", "''") }}'
{% endif %}
{% if site_project.get('werc_cc_exception') %}
cc_exception='{{ site_project.get('werc_cc_exception') | replace("'", "''") }}'
{% endif %}

conf_hide_paths _werc _docs
